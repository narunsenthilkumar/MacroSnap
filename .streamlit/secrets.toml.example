# MacroSnap - Streamlit Secrets Template
# Copy this file to .streamlit/secrets.toml and fill in your actual credentials.
# NEVER commit the real .streamlit/secrets.toml to version control.

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY = "your-gemini-api-key-here"

# Optional Gemini Model override (defaults to gemini-2.5-flash)
# GEMINI_MODEL = "gemini-2.5-flash"

# From your Twilio Console (https://console.twilio.com):
TWILIO_ACCOUNT_SID = "your-twilio-account-sid-here"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token-here"

# The Twilio Sandbox's shared WhatsApp number - leave as-is unless you have
# your own approved WhatsApp sender.
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

# The Content SID of your WhatsApp Content Template (Twilio Console >
# Messaging > Content Template Builder). Required because WhatsApp does not
# allow plain free-text messages for business-initiated sends.
TWILIO_CONTENT_SID = "your-content-template-sid-here"

# (Optional) Option B - Gmail SMTP configuration for email summaries
# GMAIL_ADDRESS = "your-email@gmail.com"
# GMAIL_APP_PASSWORD = "your-16-char-app-password"

# (Optional) Option C - Telegram Bot configuration for telegram summaries
# TELEGRAM_BOT_TOKEN = "your-telegram-bot-token"
