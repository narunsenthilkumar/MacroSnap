# MacroSnap Universal AI Vision Suite - Secrets Template
# Copy this file to .streamlit/secrets.toml and fill in your actual credentials.
# NEVER commit the real .streamlit/secrets.toml to version control.

# ==============================================================================
# 1. Google Gemini AI (Required)
# Get your free key at: https://aistudio.google.com
# ==============================================================================
GEMINI_API_KEY = "your-gemini-api-key-here"

# (Optional) Model override (defaults to gemini-2.5-flash)
# GEMINI_MODEL = "gemini-2.5-flash"


# ==============================================================================
# 2. Action Tool: WhatsApp via Twilio (Option A)
# Sign up at: https://www.twilio.com/try-twilio
# ==============================================================================
TWILIO_ACCOUNT_SID = "your-twilio-account-sid-here"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token-here"
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

# Content SID from Messaging > Content Template Builder (e.g. HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
TWILIO_CONTENT_SID = "your-content-template-sid-here"


# ==============================================================================
# 3. Action Tool: Gmail SMTP (Option B — Completely Free, Recommended)
# Turn on 2-Step Verification, then create a 16-char App Password at:
# https://myaccount.google.com/apppasswords
# ==============================================================================
# GMAIL_ADDRESS = "your-email@gmail.com"
# GMAIL_APP_PASSWORD = "your-16-character-app-password"


# ==============================================================================
# 4. Action Tool: Telegram Bot (Option C — Completely Free)
# Open Telegram, message @BotFather, send /newbot to obtain your Bot Token:
# ==============================================================================
# TELEGRAM_BOT_TOKEN = "your-telegram-bot-token-here"
